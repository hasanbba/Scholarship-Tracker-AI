{
  "name": "scholarship-tracker/crawler-worker",
  "description": "Independent Windows CLI communication worker for Scholarship Tracker",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "Scholarship\\CrawlerWorker\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "worker": "php bin/worker"
  },
  "config": {
    "sort-packages": true,
    "platform-check": true
  }
}
